{
  "expo": {
    "name": "BharathBuild",
    "slug": "bharathbuild-mobile",
    "scheme": "bharathbuild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bharathbuild.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos of your work to add to your ads.",
        "NSCameraUsageDescription": "Take photos of your work to add to your ads."
      }
    },
    "android": {
      "package": "com.bharathbuild.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D2B45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "backgroundColor": "#F8F9FB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your work to add to your ads."
        }
      ]
    ]
  }
}